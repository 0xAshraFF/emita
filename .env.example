# Jev (TypeSafe AI) System One credentials.
# Server-side only - never prefix with NEXT_PUBLIC_, or the key ships to the browser.
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-1

# Set to "1" to bypass the network and use the deterministic keyword-based
# mock router in lib/jev/mock.ts. Lets the full app run with no API key.
JEV_MOCK=1

# Emergency number rendered on the always-visible call button.
NEXT_PUBLIC_EMERGENCY_NUMBER=911
