# TypeSafe / Jev credentials, read by @typesafe-ai/sdk.
# Server-side only - never prefix with NEXT_PUBLIC_, or the key ships to the
# browser. The SDK also refuses to run in a browser unless explicitly forced.
TYPESAFE_API_KEY=

# Optional. Defaults come from the SDK.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_LOG_LEVEL=warn

# Set to "1" to bypass the network and use the deterministic keyword-based
# mock router in lib/jev/mock.ts. Lets the full app run with no API key.
# Refused in a production build.
JEV_MOCK=1

# Emergency number rendered on the always-visible call button.
NEXT_PUBLIC_EMERGENCY_NUMBER=911
